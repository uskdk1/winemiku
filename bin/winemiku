#!/bin/sh
# 개발용 실행기: 이 저장소의 Wine(runtime/ + override/)과 prefix(./prefix)로 wiku 를 실행한다.
# nix develop 없이도 쓸 수 있다 (앱 바로가기 .desktop 도 이걸 부른다. WINEMENUBUILDER_LAUNCHER).
#
#   bin/winemiku app.exe            (= wiku miku app.exe)
#   bin/winemiku --reset [app.exe]
#   bin/winemiku --kill | --kill-all | list
#
# 실제 실행기와 설정은 scripts/dev.sh 가 .cache/wiku-dev(.json) 에 만든다 (nix develop 후 wm-run 한 번).
# 배포용(nix run, home-manager)은 wiku 명령을 쓴다: flake.nix 의 wiku.lib.mkWine.
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
DEV="$ROOT/.cache/wiku-dev"
[ -x "$DEV" ] || { echo "winemiku: $DEV 가 없음. 'cd $ROOT && nix develop' 후 wm-run 을 한 번 실행할 것" >&2; exit 1; }
exec "$DEV" "$@"
