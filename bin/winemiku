#!/usr/bin/env bash
# winemiku 실행기: nix develop 없이 이 프로젝트의 Wine(runtime/)을 실행한다.
#
#   winemiku app.exe
#   winemiku "C:\\users\\miku\\Desktop\\카카오톡.lnk"
#   winemiku --reset            # prefix 초기화 (drive_c, 레지스트리, 이 prefix 의 메뉴 항목)
#   winemiku --reset app.exe    # 초기화 후 바로 실행
#   winemiku --kill             # 이 prefix 의 Wine 프로세스 전부 종료 (트레이에 숨은 앱 포함)
#   winemiku --kill-all         # 모든 prefix 의 Wine 프로세스 종료
#   WM_LANG=ja_JP.UTF-8 winemiku app.exe
#
# - Wayland 전용(DISPLAY 제거) + 한국어 로캘 + DXVK(D3D -> Vulkan)
# - override/ 에 빌드한 파일을 runtime/ 에 반영
# - prefix 가 없거나 drive_c 가 지워졌으면 깨끗한 템플릿에서 즉시 다시 만든다 (btrfs reflink)
# - 앱 바로가기(.desktop)도 이 스크립트를 부른다 (patches/0002, WINEMENUBUILDER_LAUNCHER)
set -o pipefail

# 경로 설정. 기본값은 저장소 안에서 쓰는 개발 모드이고, flake 패키지(nix run)는
# 래퍼가 WINEMIKU_* 를 설정해서 패키지 안의 Wine 과 사용자 데이터 폴더를 쓰게 한다.
#   WINEMIKU_WINE      Wine 루트 (bin/wine, bin/wineserver)         기본: <저장소>/runtime
#   WINEMIKU_SHARE     prefix.reg, cjk-fonts/, fonts/, dxvk/{x64,x32}/  기본: WINEMIKU_WINE
#   WINEMIKU_PREFIX    기본 prefix (WINEPREFIX 가 우선)             기본: <저장소>/prefix
#   WINEMIKU_TEMPLATE  깨끗한 prefix 템플릿                         기본: <저장소>/.cache/prefix-template
#   WINEMIKU_OVERRIDE  개발용으로 빌드한 파일 (없으면 생략)          기본: <저장소>/override
#   WINEMIKU_SELF      바로가기(.desktop)가 부를 실행기 경로         기본: 이 스크립트
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
RT="${WINEMIKU_WINE:-$ROOT/runtime}"
SHARE="${WINEMIKU_SHARE:-$RT}"
OVERRIDE="${WINEMIKU_OVERRIDE-$ROOT/override}"
TEMPLATE="${WINEMIKU_TEMPLATE:-$ROOT/.cache/prefix-template}"
WINE="$RT/bin/wine"
WINESERVER="$RT/bin/wineserver"

die() { echo "winemiku: $*" >&2; exit 1; }
say() { echo "winemiku: $*" >&2; }

[ -x "$WINE" ] && [ -f "$SHARE/prefix.reg" ] ||
    die "$RT 이 준비되지 않음. 'cd $ROOT && nix develop' 후 wm-run 을 한 번 실행할 것"

export WINEPREFIX="${WINEPREFIX:-${WINEMIKU_PREFIX:-$ROOT/prefix}}"
export WINEMENUBUILDER_LAUNCHER="${WINEMIKU_SELF:-$ROOT/bin/winemiku}"
export LANG="${WM_LANG:-ko_KR.UTF-8}" LC_ALL="${WM_LANG:-ko_KR.UTF-8}"
# prefix 에 넣는 native DLL(DXVK)의 원본 폴더. 이 파일들과 똑같은 DLL 은 Wine 내장 DLL 처럼
# "서명된" 것으로 본다 (patches/0005, wintrust: LINE 설치기가 system DLL 서명을 검사)
export WINEMIKU_SIGNED_DLL_DIRS="$(readlink -f "$SHARE/dxvk/x64"):$(readlink -f "$SHARE/dxvk/x32")"
unset DISPLAY
PREFIX="$WINEPREFIX"

# override/<경로> -> runtime/<경로>. 바뀌면 이전 wineserver 를 내려서 새 바이너리로 다시 뜨게 한다
sync_override() {
    [ -n "$OVERRIDE" ] && [ -d "$OVERRIDE" ] || return 0
    local src rel changed=0
    while IFS= read -r -d '' src; do
        rel="${src#"$OVERRIDE"/}"
        if ! cmp -s "$src" "$RT/$rel"; then
            mkdir -p "$(dirname "$RT/$rel")"
            rm -f "$RT/$rel"; cp "$src" "$RT/$rel"; changed=1
        fi
    done < <(find "$OVERRIDE" -type f -print0)
    if [ $changed = 1 ]; then "$WINESERVER" -k 2>/dev/null; true; fi
}

# 쓰고 있는 Wine 빌드 (store 경로)
wine_id() { cat "$RT/.vanilla" 2>/dev/null || readlink -f "$RT"; }

# wine 버전 + 레지스트리 설정 + 폰트가 같으면 같은 prefix 로 본다
prefix_key() {
    { wine_id; sha256sum < "$SHARE/prefix.reg"; readlink -f "$SHARE/cjk-fonts" "$SHARE/fonts" "$SHARE/dxvk"; } |
        sha256sum | cut -d' ' -f1
}

# 이 prefix 를 가리키는 앱 메뉴 항목(.desktop / .menu) 삭제. 다른 prefix 것은 건드리지 않는다
clean_menus() {
    local apps="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
    local menus="${XDG_CONFIG_HOME:-$HOME/.config}/menus/applications-merged"
    local f id n=0
    [ -d "$apps" ] || return 0
    while IFS= read -r -d '' f; do
        id="${f#"$apps"/}"; id="${id//\//-}"
        rm -f "$f" "$menus/${id%.desktop}.menu"
        n=$((n + 1))
    done < <(grep -rlZF --include='*.desktop' "\"WINEPREFIX=$PREFIX\"" "$apps" 2>/dev/null)
    find "$apps/wine" -mindepth 1 -type d -empty -delete 2>/dev/null
    [ $n -gt 0 ] && say "메뉴 항목 ${n}개 삭제"
    return 0
}

reset_prefix() {
    # 안전장치: winemiku 가 만든 prefix(.wm-prefix 표시)만 지운다
    if [ -e "$PREFIX" ] && [ ! -f "$PREFIX/.wm-prefix" ] && [ ! -f "$PREFIX/.wm-prefix.tmp" ]; then
        die "$PREFIX 는 winemiku 가 만든 prefix 가 아니라서 지우지 않음"
    fi
    "$WINESERVER" -k 2>/dev/null
    "$WINESERVER" -w 2>/dev/null
    rm -rf "$PREFIX"
    clean_menus
    say "prefix 초기화: $PREFIX"
}

# 기존 prefix 에 한글 폰트 + DXVK + 레지스트리(폰트 대체, Wayland, DLL override) 적용
setup_prefix() {
    local f
    # Wine 이 바뀌었으면 prefix 의 system32/syswow64 (새 DLL 등)를 갱신한다. Wine 은 wine.inf 의
    # mtime 이 .update-timestamp 와 다를 때만 스스로 갱신하는데, Nix store 는 mtime 이 항상 1 이라
    # 버전을 바꿔도 갱신되지 않는다 (예: staging 으로 바꾼 뒤 wkscli.dll, icu.dll 이 없어서
    # WebView2 설치기와 카카오톡의 icuuc.dll 이 깨졌다). DXVK 는 아래에서 다시 덮어쓴다.
    if [ "$(cat "$PREFIX/.wm-wine" 2>/dev/null)" != "$(wine_id)" ]; then
        WINEDLLOVERRIDES="winemenubuilder.exe=d${WINEDLLOVERRIDES:+;$WINEDLLOVERRIDES}" \
            "$WINE" wineboot -u >/dev/null 2>&1
        # wineboot 이 시작 프로그램(Run 키, 예: 카카오톡 -bystartup)까지 띄워서 -w 가 끝나지 않는다
        "$WINESERVER" -k 2>/dev/null; "$WINESERVER" -w
        wine_id > "$PREFIX/.wm-wine"
    fi
    # DXVK: D3D -> Vulkan. wined3d(D3D -> OpenGL)는 Wayland 에서 화면이 갱신 안 되는 앱이 있다 (카카오톡)
    for f in d3d8 d3d9 d3d10core d3d11 dxgi; do
        cp -f --remove-destination "$SHARE/dxvk/x64/$f.dll" "$PREFIX/drive_c/windows/system32/$f.dll" &&
        cp -f --remove-destination "$SHARE/dxvk/x32/$f.dll" "$PREFIX/drive_c/windows/syswow64/$f.dll" || die "DXVK 설치 실패 ($f)"
    done
    mkdir -p "$PREFIX/drive_c/windows/Fonts"
    for f in NotoSansCJK-Regular.ttc NotoSansCJK-Bold.ttc; do
        ln -sfn "$SHARE/cjk-fonts/$f" "$PREFIX/drive_c/windows/Fonts/$f"
    done
    # scripts/gen-fonts.py 가 만든 폰트 (Segoe UI·Malgun Gothic 이름의 Noto, DejaVu Sans, Arimo. 등록은 prefix.reg)
    for f in "$SHARE"/fonts/*; do
        ln -sfn "$f" "$PREFIX/drive_c/windows/Fonts/${f##*/}"
    done
    cp -f "$SHARE/prefix.reg" "$PREFIX/.wm-prefix.reg"
    "$WINE" regedit /S "Z:${PREFIX//\//\\}\\.wm-prefix.reg" >/dev/null 2>&1 || die "레지스트리 적용 실패"
    "$WINESERVER" -w
    prefix_key > "$PREFIX/.wm-prefix"
}

ensure_prefix() {
    local key; key=$(prefix_key)
    if [ -e "$PREFIX" ] && [ ! -d "$PREFIX/drive_c" ]; then
        say "drive_c 가 없음 -> prefix 를 새로 만든다"
        reset_prefix
    fi
    if [ ! -d "$PREFIX" ]; then
        if [ "$(cat "$TEMPLATE/.wm-prefix" 2>/dev/null)" = "$key" ]; then
            cp -a --reflink=auto "$TEMPLATE" "$PREFIX" || die "템플릿 복사 실패"
            say "prefix 생성 (템플릿)"
            return 0
        fi
        say "prefix 생성 중 (처음 한 번은 오래 걸림)..."
        mkdir -p "$PREFIX"; prefix_key > "$PREFIX/.wm-prefix.tmp"
        # 만드는 동안은 winemenubuilder 를 끈다: 기본 RunServices 의 "-a" 가 공유 이름의
        # wine-extension-*.desktop 을 덮어쓰기 때문 (prefix.reg 가 이후 세션에서는 -r 만 남긴다)
        (
            export WINEDLLOVERRIDES="winemenubuilder.exe=d${WINEDLLOVERRIDES:+;$WINEDLLOVERRIDES}"
            "$WINE" wineboot -u >/dev/null 2>&1
            "$WINESERVER" -w
            wine_id > "$PREFIX/.wm-wine"
            setup_prefix
        ) || exit 1
        rm -f "$PREFIX/.wm-prefix.tmp"
        rm -rf "$TEMPLATE"; mkdir -p "$(dirname "$TEMPLATE")"
        cp -a --reflink=auto "$PREFIX" "$TEMPLATE" && say "템플릿 저장: $TEMPLATE"
    elif [ "$(cat "$PREFIX/.wm-prefix" 2>/dev/null)" != "$key" ]; then
        setup_prefix
        say "prefix 설정 갱신 (한글 폰트, DXVK, Wayland)"
    fi
}

# 이 prefix 의 Wine 프로세스 전부 종료 (트레이에 숨은 앱, services/explorer 등)
kill_prefix() {
    local p="${1:-$PREFIX}"
    WINEPREFIX="$p" "$WINESERVER" -k 2>/dev/null || return 0
    WINEPREFIX="$p" timeout 10 "$WINESERVER" -w 2>/dev/null
    say "종료: $p"
}

# runtime/ 의 wineserver 로 뜬 모든 prefix 의 Wine 프로세스 종료
kill_all() {
    local pid exe p n=0
    for pid in $(pgrep -x wineserver); do
        exe=$(readlink -f "/proc/$pid/exe" 2>/dev/null) || continue
        # 이 저장소의 runtime/ wineserver 만 (다른 Wine 설치는 건드리지 않음)
        [ "$exe" = "$(readlink -f "$WINESERVER")" ] || continue
        p=$(tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null | sed -n 's/^WINEPREFIX=//p')
        [ -n "$p" ] || p="$HOME/.wine"
        kill_prefix "$p"; n=$((n + 1))
    done
    [ $n = 0 ] && say "실행 중인 Wine 없음"
    return 0
}

case "$1" in
    --kill) kill_prefix; exit 0 ;;
    --kill-all) kill_all; exit 0 ;;
esac

sync_override
if [ "$1" = --reset ]; then
    shift
    reset_prefix
    ensure_prefix
    [ $# -eq 0 ] && exit 0
fi
ensure_prefix
exec "$WINE" "$@"
