@@ -594,9 +595,25 @@ static void wayland_configure_window(HWND hwnd)
     memset(&surface->requested, 0, sizeof(surface->requested));
 
     state = surface->processing.state;
+    /* The compositor makes the window fullscreen, or ends that. Win32 has no
+     * fullscreen state: the window is just resized to the monitor, so it has
+     * to be resized back afterwards, else it stays a "normal" window of the
+     * monitor's size, which Win32 keeps treating as a fullscreen one (cursor
+     * clipped to it). */
+    if ((state & WAYLAND_SURFACE_CONFIG_STATE_FULLSCREEN) &&
+        !(surface->current.state & WAYLAND_SURFACE_CONFIG_STATE_FULLSCREEN) &&
+        !(surface->window.state & WAYLAND_SURFACE_CONFIG_STATE_FULLSCREEN))
+    {
+        RECT old = map_rect_to_surface(surface, data->rects.window);
+        surface->unfullscreen_size.cx = old.right - old.left;
+        surface->unfullscreen_size.cy = old.bottom - old.top;
+    }
+    leaving_fullscreen = (surface->current.state & WAYLAND_SURFACE_CONFIG_STATE_FULLSCREEN) &&
+                         !(state & WAYLAND_SURFACE_CONFIG_STATE_FULLSCREEN);
+
     /* Ignore size hints if we don't have a state that requires strict
      * size adherence, in order to avoid spurious resizes. */
-    if (state)
+    if (state || leaving_fullscreen)
     {
         width = surface->processing.rect.right - surface->processing.rect.left;
         height = surface->processing.rect.bottom - surface->processing.rect.top;
@@ -605,6 +622,17 @@ static void wayland_configure_window(HWND hwnd)
     {
         width = height = 0;
     }
+    if (leaving_fullscreen)
+    {
+        /* the compositor's size (normally the one from before), else ours */
+        if (!state && (!width || !height))
+        {
+            width = surface->unfullscreen_size.cx;
+            height = surface->unfullscreen_size.cy;
+        }
+        TRACE("hwnd=%p leaving fullscreen, size %dx%d\n", hwnd, width, height);
+        memset(&surface->unfullscreen_size, 0, sizeof(surface->unfullscreen_size));
+    }
 
     if ((state & WAYLAND_SURFACE_CONFIG_STATE_RESIZING) && !surface->resizing)
