+        int dx = monitor.rc_monitor.right - monitor.rc_monitor.left - work.cx;
+        int dy = monitor.rc_monitor.bottom - monitor.rc_monitor.top - work.cy;
+        POINT click;
+        BOOL bottom = process_wayland.initialized && wayland_systray_last_click(&click) &&
+                      click.x >= state->logical_x && click.x < state->logical_x + state->logical_w &&
+                      click.y - state->logical_y > state->logical_h / 2;
+
+        if (dx > 0) monitor.rc_work.left += dx;
+        if (dy > 0)
+        {
+            if (bottom) monitor.rc_work.bottom -= dy;
+            else monitor.rc_work.top += dy;
