+/**********************************************************************
+ *          Work area probe
+ *
+ * Wayland doesn't tell clients the work area (the output minus the bars'
+ * exclusive zones), but a layer surface anchored to all edges with an
+ * exclusive zone of 0 is given exactly that size by the compositor. Win32
+ * needs the work area: a maximized window's client area is the work area,
+ * and the compositor's maximized size must match it, else apps that insist
+ * on it (Qt) fight the compositor forever.
+ */
+static void work_probe_destroy(struct wayland_output *output)
+{
+    if (output->work_layer) zwlr_layer_surface_v1_destroy(output->work_layer);
+    if (output->work_viewport) wp_viewport_destroy(output->work_viewport);
+    if (output->work_surface) wl_surface_destroy(output->work_surface);
+    if (output->work_buffer) wayland_shm_buffer_unref(output->work_buffer);
+    output->work_layer = NULL;
+    output->work_viewport = NULL;
+    output->work_surface = NULL;
+    output->work_buffer = NULL;
+}
+
+static void work_probe_handle_configure(void *data, struct zwlr_layer_surface_v1 *layer_surface,
+                                        uint32_t serial, uint32_t width, uint32_t height)
+{
+    struct wayland_output *output = data;
+    BOOL changed;
+
+    zwlr_layer_surface_v1_ack_configure(layer_surface, serial);
+    if (width && height)
+    {
+        wp_viewport_set_destination(output->work_viewport, width, height);
+        wl_surface_attach(output->work_surface, output->work_buffer->wl_buffer, 0, 0);
+        wl_surface_damage_buffer(output->work_surface, 0, 0, 1, 1);
+    }
+    wl_surface_commit(output->work_surface);
+    wl_display_flush(process_wayland.wl_display);
+
+    pthread_mutex_lock(&process_wayland.output_mutex);
+    changed = output->work_w != width || output->work_h != height;
+    output->work_w = width;
+    output->work_h = height;
+    pthread_mutex_unlock(&process_wayland.output_mutex);
+
+    TRACE("output=%s work area %ux%u%s\n", output->current.name, width, height,
+          changed ? " (changed)" : "");
+    if (changed) maybe_init_display_devices();
+}
+
+static void work_probe_handle_closed(void *data, struct zwlr_layer_surface_v1 *layer_surface)
+{
+    TRACE("output=%p\n", data);
+}
+
+static const struct zwlr_layer_surface_v1_listener work_probe_listener =
+{
+    work_probe_handle_configure,
+    work_probe_handle_closed,
+};
+
+static void work_probe_create(struct wayland_output *output)
+{
+    struct wl_region *region;
+
+    if (output->work_surface || !process_wayland.work_probes) return;
+    if (!process_wayland.zwlr_layer_shell_v1 || !process_wayland.wp_viewporter) return;
+
+    if (!(output->work_buffer = wayland_shm_buffer_create(1, 1, WL_SHM_FORMAT_ARGB8888)) ||
+        !(output->work_surface = wl_compositor_create_surface(process_wayland.wl_compositor)))
+        goto failed;
+    memset(output->work_buffer->map_data, 0, output->work_buffer->map_size); /* transparent */
+    wl_surface_set_user_data(output->work_surface, NULL);
+    /* never takes input */
+    if ((region = wl_compositor_create_region(process_wayland.wl_compositor)))
+    {
+        wl_surface_set_input_region(output->work_surface, region);
+        wl_region_destroy(region);
+    }
+    if (!(output->work_viewport = wp_viewporter_get_viewport(process_wayland.wp_viewporter,
+                                                             output->work_surface)))
+        goto failed;
+    if (!(output->work_layer =
+          zwlr_layer_shell_v1_get_layer_surface(process_wayland.zwlr_layer_shell_v1,
+                                                output->work_surface, output->wl_output,
+                                                ZWLR_LAYER_SHELL_V1_LAYER_BACKGROUND,
+                                                "wine-work-area")))
+        goto failed;
+    zwlr_layer_surface_v1_add_listener(output->work_layer, &work_probe_listener, output);
+    zwlr_layer_surface_v1_set_anchor(output->work_layer,
+                                     ZWLR_LAYER_SURFACE_V1_ANCHOR_TOP | ZWLR_LAYER_SURFACE_V1_ANCHOR_BOTTOM |
+                                     ZWLR_LAYER_SURFACE_V1_ANCHOR_LEFT | ZWLR_LAYER_SURFACE_V1_ANCHOR_RIGHT);
+    zwlr_layer_surface_v1_set_size(output->work_layer, 0, 0);
+    zwlr_layer_surface_v1_set_exclusive_zone(output->work_layer, 0);
+    wl_surface_commit(output->work_surface);
+    wl_display_flush(process_wayland.wl_display);
+    TRACE("output=%s\n", output->current.name);
+    return;
+
+failed:
+    ERR("failed to create the work area probe for %s\n", output->current.name);
+    work_probe_destroy(output);
+}
+
+/**********************************************************************
+ *          wayland_output_enable_work_probes
+ *
+ * Called in the desktop process (the only one updating the display devices).
+ */
+void wayland_output_enable_work_probes(void)
+{
+    struct wayland_output *output;
+
+    process_wayland.work_probes = TRUE;
+    pthread_mutex_lock(&process_wayland.output_mutex);
+    wl_list_for_each(output, &process_wayland.output_list, link)
+        work_probe_create(output);
+    pthread_mutex_unlock(&process_wayland.output_mutex);
+}
+
 static void wayland_output_mode_free_rb(struct rb_entry *entry, void *ctx)
 {
     free(RB_ENTRY_VALUE(entry, struct wayland_output_mode, entry));
@@ -179,6 +298,8 @@ static void wayland_output_done(struct wayland_output *output)
 
     pthread_mutex_unlock(&process_wayland.output_mutex);
 
+    work_probe_create(output); /* for outputs that appear later */
+
     TRACE("name=%s logical=%d,%d+%dx%d\n",
           output->current.name, output->current.logical_x, output->current.logical_y,
           output->current.logical_w, output->current.logical_h);
@@ -371,6 +492,8 @@ void wayland_output_destroy(struct wayland_output *output)
     wl_list_remove(&output->link);
     pthread_mutex_unlock(&process_wayland.output_mutex);
 
+    work_probe_destroy(output);
+
     wayland_output_state_deinit(&output->pending);
     wayland_output_state_deinit(&output->current);
     if (output->zxdg_output_v1)
