+/**********************************************************************
+ *           wayland_learn_work_area
+ *
+ * The size the compositor gives to a maximized toplevel is the work area of
+ * its monitor: tell the desktop process (see wayland_set_work_area), before
+ * the window is fitted to it. Returns whether the monitor's work area
+ * changed, and by how much each of its edges moved.
+ */
+static BOOL wayland_learn_work_area(HWND hwnd, RECT *moved)
+{
+    struct send_message_timeout_params params = {.flags = SMTO_ABORTIFHUNG, .timeout = 2000};
+    MONITORINFO mi = {.cbSize = sizeof(mi)}, new_mi = {.cbSize = sizeof(new_mi)};
+    struct wayland_surface *surface;
+    struct wayland_win_data *data;
+    HMONITOR monitor;
+    RECT rect = {0};
+    int width, height;
+
+    if (!(data = wayland_win_data_get(hwnd))) return FALSE;
+    if ((surface = data->wayland_surface) && wayland_surface_is_toplevel(surface) &&
+        surface->requested.serial &&
+        (surface->requested.state & WAYLAND_SURFACE_CONFIG_STATE_MAXIMIZED) &&
+        !(surface->requested.state & WAYLAND_SURFACE_CONFIG_STATE_FULLSCREEN))
+        rect = map_rect_from_surface(surface, surface->requested.rect);
+    wayland_win_data_release(data);
+
+    width = rect.right - rect.left;
+    height = rect.bottom - rect.top;
+    if (width <= 0 || height <= 0 || width > 0xffff || height > 0xffff) return FALSE;
+    if (!(monitor = NtUserMonitorFromWindow(hwnd, MONITOR_DEFAULTTONEAREST)) ||
+        !NtUserGetMonitorInfo(monitor, &mi))
+        return FALSE;
+    if (mi.rcWork.right - mi.rcWork.left == width && mi.rcWork.bottom - mi.rcWork.top == height)
+        return FALSE;
+
+    TRACE("hwnd=%p monitor=%s work=%s maximized size %dx%d\n", hwnd,
+          wine_dbgstr_rect(&mi.rcMonitor), wine_dbgstr_rect(&mi.rcWork), width, height);
+    /* wp = monitor origin, lp = size; the display devices are updated on return */
+    NtUserMessageCall(NtUserGetDesktopWindow(), WM_WAYLAND_SET_WORK_AREA,
+                      MAKELONG(mi.rcMonitor.left, mi.rcMonitor.top), MAKELONG(width, height),
+                      &params, NtUserSendMessageTimeout, FALSE);
+
+    if (!NtUserGetMonitorInfo(monitor, &new_mi) || EqualRect(&new_mi.rcWork, &mi.rcWork))
+        return FALSE;
+    SetRect(moved, new_mi.rcWork.left - mi.rcWork.left, new_mi.rcWork.top - mi.rcWork.top,
+            new_mi.rcWork.right - mi.rcWork.right, new_mi.rcWork.bottom - mi.rcWork.bottom);
+    return TRUE;
+}
