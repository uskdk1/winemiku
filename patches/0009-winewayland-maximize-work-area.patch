+/***********************************************************************
+ *           wayland_systray_last_click
+ *
+ * Where the tray was last clicked (compositor coordinates), if ever. A
+ * hint about where the bar is.
+ */
+BOOL wayland_systray_last_click(POINT *pos)
+{
+    HWND desktop = NtUserGetDesktopWindow();
+    DWORD packed;
+
+    if (!NtUserGetProp(desktop, click_time_prop)) return FALSE;
+    packed = HandleToUlong(NtUserGetProp(desktop, click_pos_prop));
+    pos->x = (SHORT)LOWORD(packed);
+    pos->y = (SHORT)HIWORD(packed);
+    return pos->x || pos->y; /* 0,0 = the bar didn't say */
+}
