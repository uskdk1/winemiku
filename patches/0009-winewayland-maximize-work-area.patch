+/**********************************************************************
+ *          Work areas
+ *
+ * Wayland has no request for the work area (the output minus the bars), but
+ * xdg-shell tells a toplevel what matters about it: the size it gets when
+ * maximized (xdg_toplevel.configure with the maximized state). Win32 needs
+ * it: the client area of a maximized window is the work area, and apps that
+ * insist on that (Qt) fight the compositor forever if its maximized size is
+ * different. So until a window has been maximized on a monitor, its work
+ * area is the whole monitor. (xdg_toplevel.configure_bounds is no use: it
+ * is the work area for some compositors, but the output or the work area
+ * minus gaps for others, changing with the window's state.)
+ *
+ * The toplevels' processes report these sizes to the desktop process (the
+ * only one updating the display devices) with WM_WAYLAND_SET_WORK_AREA.
+ * They are kept by monitor origin, in the monitor's physical pixels.
+ */
+struct work_area
+{
+    int x, y, width, height;
+};
+
+static pthread_mutex_t work_area_mutex = PTHREAD_MUTEX_INITIALIZER;
+static struct work_area work_areas[16];
+static unsigned int work_area_count;
+
+/* Returns whether the work area changed. */
+BOOL wayland_set_work_area(int x, int y, int width, int height)
+{
+    struct work_area *area = NULL;
+    BOOL changed = FALSE;
+    unsigned int i;
+
+    if (width <= 0 || height <= 0) return FALSE;
+
+    pthread_mutex_lock(&work_area_mutex);
+    for (i = 0; i < work_area_count; i++)
+        if (work_areas[i].x == x && work_areas[i].y == y) area = &work_areas[i];
+    if (!area && work_area_count < ARRAY_SIZE(work_areas))
+    {
+        area = &work_areas[work_area_count++];
+        memset(area, 0, sizeof(*area));
+        area->x = x;
+        area->y = y;
+    }
+    if (area && (area->width != width || area->height != height))
+    {
+        area->width = width;
+        area->height = height;
+        changed = TRUE;
+    }
+    pthread_mutex_unlock(&work_area_mutex);
+
+    TRACE("monitor=%d,%d work area %dx%d%s\n", x, y, width, height, changed ? " (changed)" : "");
+    return changed;
+}
+
+static BOOL get_work_area_size(const RECT *monitor, SIZE *size)
+{
+    BOOL ret = FALSE;
+    unsigned int i;
+
+    pthread_mutex_lock(&work_area_mutex);
+    for (i = 0; i < work_area_count; i++)
+    {
+        const struct work_area *area = &work_areas[i];
+        if (area->x != monitor->left || area->y != monitor->top) continue;
+        /* stale (the output changed) or from a window that is really
+         * on another output than Win32 thinks */
+        if (area->width > monitor->right - monitor->left ||
+            area->height > monitor->bottom - monitor->top) continue;
+        size->cx = area->width;
+        size->cy = area->height;
+        ret = TRUE;
+    }
+    pthread_mutex_unlock(&work_area_mutex);
+    return ret;
+}
+
