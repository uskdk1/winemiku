diff --git a/dlls/winewayland.drv/window.c b/dlls/winewayland.drv/window.c
index eacdb26..c459894 100644
--- a/dlls/winewayland.drv/window.c
+++ b/dlls/winewayland.drv/window.c
@@ -145,24 +145,31 @@ static void wayland_win_data_get_config(struct wayland_win_data *data,
 
     conf->minimized = !!(style & WS_MINIMIZE);
 
+    /* A maximized window covers the work area, which is the whole monitor
+     * until we learn it from the compositor: keep it maximized even without
+     * a caption (e.g. FL Studio's borderless main window), xdg fullscreen
+     * would hide the bar and lock everything else out. */
+    if (style & WS_MAXIMIZE)
+    {
+        window_state |= WAYLAND_SURFACE_CONFIG_STATE_MAXIMIZED;
+    }
     /* The fullscreen state is implied by the window position and style. */
-    if (data->is_fullscreen)
+    else if (data->is_fullscreen)
     {
-        if ((style & WS_MAXIMIZE) && (style & WS_CAPTION) == WS_CAPTION)
+        BOOL caption = (style & WS_CAPTION) == WS_CAPTION;
+
+        /* The same goes for a borderless window with a maximize box that sized
+         * itself to the monitor (FL Studio restoring its maximized size):
+         * fullscreen games don't set it. */
+        if (!caption && (style & WS_MAXIMIZEBOX))
             window_state |= WAYLAND_SURFACE_CONFIG_STATE_MAXIMIZED;
         /* A resizable window with a caption that merely happens to be as
          * large as the monitor (e.g. restored from a saved maximized size)
          * is an ordinary window, not a fullscreen app: keep it movable and
          * resizable instead of locking it into the xdg fullscreen state. */
-        else if ((style & WS_CAPTION) == WS_CAPTION && (style & WS_THICKFRAME))
-            ;
-        else if (!(style & WS_MINIMIZE))
+        else if (!(caption && (style & WS_THICKFRAME)) && !(style & WS_MINIMIZE))
             window_state |= WAYLAND_SURFACE_CONFIG_STATE_FULLSCREEN;
     }
-    else if (style & WS_MAXIMIZE)
-    {
-        window_state |= WAYLAND_SURFACE_CONFIG_STATE_MAXIMIZED;
-    }
 
     conf->resizeable = data->resizeable;
     conf->state = window_state;
@@ -483,8 +490,10 @@ void WAYLAND_WindowPosChanged(HWND hwnd, HWND insert_after, HWND owner_hint, UIN
      * maximized or merely that large, that would pin the xdg min/max size to
      * the current size, which the compositor then can't maximize or resize
      * (and some compositors answer every min/max change with a configure,
-     * which loops). */
-    data->resizeable = !!(NtUserGetWindowLongW(hwnd, GWL_STYLE) & WS_THICKFRAME);
+     * which loops). Maximized windows too: they follow the compositor's
+     * maximized size (the work area), not the monitor. */
+    data->resizeable = (NtUserGetWindowLongW(hwnd, GWL_STYLE) & (WS_THICKFRAME | WS_MAXIMIZE)) ||
+                       (fullscreen && (NtUserGetWindowLongW(hwnd, GWL_STYLE) & WS_MAXIMIZEBOX));
     data->managed = managed;
 
