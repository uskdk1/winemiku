diff --git a/dlls/winewayland.drv/wayland_surface.c b/dlls/winewayland.drv/wayland_surface.c
index a5739db..d6f8259 100644
--- a/dlls/winewayland.drv/wayland_surface.c
+++ b/dlls/winewayland.drv/wayland_surface.c
@@ -627,6 +627,7 @@ void wayland_surface_make_toplevel(struct wayland_surface *surface)
     xdg_surface_add_listener(surface->xdg_surface, &xdg_surface_listener, surface->hwnd);
 
     surface->xdg_toplevel = xdg_surface_get_toplevel(surface->xdg_surface);
+    surface->size_limit_width = surface->size_limit_height = -1;
     if (!surface->xdg_toplevel) goto err;
     xdg_toplevel_add_listener(surface->xdg_toplevel, &xdg_toplevel_listener, surface->hwnd);
 
@@ -1089,15 +1090,17 @@ static void wayland_surface_reconfigure_geometry(struct wayland_surface *surface
         xdg_surface_set_window_geometry(surface->xdg_surface,
                                         rect.left, rect.top,
                                         width, height);
-        if (surface->window.resizeable)
-        {
-            xdg_toplevel_set_min_size(surface->xdg_toplevel, 0, 0);
-            xdg_toplevel_set_max_size(surface->xdg_toplevel, 0, 0);
-        }
-        else
+        int limit_width = surface->window.resizeable ? 0 : width;
+        int limit_height = surface->window.resizeable ? 0 : height;
+
+        /* Only send changes: some compositors (niri) answer every min/max size
+         * request with a configure, which comes back here and loops. */
+        if (limit_width != surface->size_limit_width || limit_height != surface->size_limit_height)
         {
-            xdg_toplevel_set_min_size(surface->xdg_toplevel, width, height);
-            xdg_toplevel_set_max_size(surface->xdg_toplevel, width, height);
+            xdg_toplevel_set_min_size(surface->xdg_toplevel, limit_width, limit_height);
+            xdg_toplevel_set_max_size(surface->xdg_toplevel, limit_width, limit_height);
+            surface->size_limit_width = limit_width;
+            surface->size_limit_height = limit_height;
         }
     }
 }
