+static pthread_mutex_t sni_mutex = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t sni_cond = PTHREAD_COND_INITIALIZER;
+static struct list sni_icons = LIST_INIT(sni_icons);
+static enum { SNI_DISABLED, SNI_STARTING, SNI_RUNNING } sni_state = SNI_DISABLED;
+static int wake_pipe[2] = {-1, -1};
+static unsigned int next_number;
+
+/* systray thread only */
+static DBusConnection *main_conn;
+static BOOL watcher_present;
+static BOOL reregister_all;
+
+static void wake_systray_thread(void)
+{
+    char c = 0;
+    while (write(wake_pipe[1], &c, 1) == -1 && errno == EINTR) continue;
+}
+
+static char *utf8_from_wstr(const WCHAR *str)
+{
+    DWORD len = lstrlenW(str), size = 0;
+    char *ret;
+
+    RtlUnicodeToUTF8N(NULL, 0, &size, str, len * sizeof(WCHAR));
+    if (!(ret = malloc(size + 1))) return NULL;
+    RtlUnicodeToUTF8N(ret, size, &size, str, len * sizeof(WCHAR));
+    ret[size] = 0;
+    return ret;
+}
+
+/* convert an icon to the non-premultiplied, big-endian ARGB32 that SNI wants */
+static BOOL pixels_from_icon(HICON hicon, unsigned char **ret_pixels, int *ret_width, int *ret_height)
+{
+    char buffer[FIELD_OFFSET(BITMAPINFO, bmiColors[256])];
+    BITMAPINFO *info = (BITMAPINFO *)buffer;
+    unsigned int *bits = NULL, count, i, j;
+    unsigned char *mask = NULL, *out;
+    BOOL has_alpha = FALSE, ret = FALSE;
+    ICONINFO ii;
+    BITMAP bm;
+    HDC hdc;
+
+    if (!NtUserGetIconInfo(hicon, &ii, NULL, NULL, NULL, 0)) return FALSE;
+    hdc = NtGdiCreateCompatibleDC(0);
+
+    if (!ii.hbmColor || !NtGdiExtGetObjectW(ii.hbmColor, sizeof(bm), &bm)) goto done;
+    if (bm.bmWidth <= 0 || bm.bmHeight <= 0 || bm.bmWidth > 1024 || bm.bmHeight > 1024) goto done;
+    count = bm.bmWidth * bm.bmHeight;
+
+    memset(&info->bmiHeader, 0, sizeof(info->bmiHeader));
+    info->bmiHeader.biSize = sizeof(BITMAPINFOHEADER);
+    info->bmiHeader.biWidth = bm.bmWidth;
+    info->bmiHeader.biHeight = -bm.bmHeight;
+    info->bmiHeader.biPlanes = 1;
+    info->bmiHeader.biBitCount = 32;
+    info->bmiHeader.biCompression = BI_RGB;
+    info->bmiHeader.biSizeImage = count * 4;
+    if (!(bits = malloc(count * 4))) goto done;
+    if (!NtGdiGetDIBitsInternal(hdc, ii.hbmColor, 0, bm.bmHeight, bits, info, DIB_RGB_COLORS, 0, 0))
+        goto done;
+
+    for (i = 0; i < count; i++)
+        if ((has_alpha = (bits[i] & 0xff000000) != 0)) break;
+
+    if (!has_alpha)
+    {
+        /* generate the alpha channel from the mask */
+        unsigned int width_bytes = (bm.bmWidth + 31) / 32 * 4;
+
+        info->bmiHeader.biBitCount = 1;
+        info->bmiHeader.biSizeImage = width_bytes * bm.bmHeight;
+        if (!(mask = malloc(info->bmiHeader.biSizeImage))) goto done;
+        if (!NtGdiGetDIBitsInternal(hdc, ii.hbmMask, 0, bm.bmHeight, mask, info, DIB_RGB_COLORS, 0, 0))
+            goto done;
+        for (i = 0; i < bm.bmHeight; i++)
+            for (j = 0; j < bm.bmWidth; j++)
+                if (!((mask[i * width_bytes + j / 8] << (j % 8)) & 0x80))
+                    bits[i * bm.bmWidth + j] |= 0xff000000;
+    }
+
+    if (!(out = malloc(count * 4))) goto done;
+    for (i = 0; i < count; i++)
+    {
+        out[4 * i + 0] = bits[i] >> 24;
+        out[4 * i + 1] = bits[i] >> 16;
+        out[4 * i + 2] = bits[i] >> 8;
+        out[4 * i + 3] = bits[i];
+    }
+    *ret_pixels = out;
+    *ret_width = bm.bmWidth;
+    *ret_height = bm.bmHeight;
+    ret = TRUE;
+
+done:
+    free(bits);
+    free(mask);
+    NtGdiDeleteObjectApp(hdc);
+    if (ii.hbmColor) NtGdiDeleteObjectApp(ii.hbmColor);
+    if (ii.hbmMask) NtGdiDeleteObjectApp(ii.hbmMask);
+    return ret;
+}
+
+/* sni_mutex must be held */
+static struct sni_icon *get_icon(HWND owner, UINT id)
+{
+    struct sni_icon *icon;
+
+    LIST_FOR_EACH_ENTRY(icon, &sni_icons, struct sni_icon, entry)
+        if (!icon->deleted && icon->owner == owner && icon->id == id) return icon;
+    return NULL;
+}
+
+/* sni_mutex must be held. pixels/tip are taken over when used (set to NULL). */
+static void modify_icon(struct sni_icon *icon, const NOTIFYICONDATAW *nid,
+                        unsigned char **pixels, int width, int height, char **tip)
+{
+    if (nid->uFlags & NIF_STATE)
+    {
+        DWORD mask = nid->dwStateMask & NIS_HIDDEN;
+        BOOL hidden = (mask & nid->dwState) ? TRUE : (mask ? FALSE : icon->hidden);
+        if (hidden != icon->hidden)
+        {
+            icon->hidden = hidden;
+            icon->updates |= UPDATE_STATUS;
+        }
+    }
+    if (nid->uFlags & NIF_ICON)
+    {
+        free(icon->pixels);
+        icon->pixels = *pixels;
+        icon->width = width;
+        icon->height = height;
+        *pixels = NULL;
+        icon->updates |= UPDATE_ICON;
+    }
+    if (nid->uFlags & NIF_MESSAGE) icon->callback_message = nid->uCallbackMessage;
+    if ((nid->uFlags & NIF_TIP) && *tip)
+    {
+        free(icon->tip);
+        icon->tip = *tip;
+        *tip = NULL;
+        icon->updates |= UPDATE_TIP;
+    }
+}
+
+static BOOL wait_systray_thread(void)
+{
+    BOOL ret;
+
+    pthread_mutex_lock(&sni_mutex);
+    if (sni_state == SNI_STARTING)
+    {
+        struct timespec ts;
+        clock_gettime(CLOCK_REALTIME, &ts);
+        ts.tv_sec += 5;
+        while (sni_state == SNI_STARTING &&
+               pthread_cond_timedwait(&sni_cond, &sni_mutex, &ts) != ETIMEDOUT)
+            continue;
+    }
+    ret = sni_state == SNI_RUNNING;
+    pthread_mutex_unlock(&sni_mutex);
+    return ret;
+}
+
+/***********************************************************************
+ *           WAYLAND_NotifyIcon
+ *
+ * Called in the explorer process for each Shell_NotifyIcon. Returning -1
+ * makes explorer handle the icon itself (its own tray window).
+ */
+LRESULT WAYLAND_NotifyIcon(HWND hwnd, UINT msg, NOTIFYICONDATAW *nid)
+{
+    unsigned char *pixels = NULL;
+    int width = 0, height = 0;
+    char *tip = NULL;
+    struct sni_icon *icon;
+    LRESULT ret = FALSE;
+
+    if (!wait_systray_thread()) return -1;
+
+    TRACE("msg %u hwnd %p id %#x flags %#x\n", msg, nid->hWnd, nid->uID, nid->uFlags);
+
+    if (msg == NIM_ADD || msg == NIM_MODIFY)
+    {
+        if ((nid->uFlags & NIF_ICON) && nid->hIcon &&
+            !pixels_from_icon(nid->hIcon, &pixels, &width, &height))
+            WARN("failed to convert icon %p\n", nid->hIcon);
+        if (nid->uFlags & NIF_TIP) tip = utf8_from_wstr(nid->szTip);
+    }
+
+    pthread_mutex_lock(&sni_mutex);
+    icon = get_icon(nid->hWnd, nid->uID);
+    switch (msg)
+    {
+    case NIM_ADD:
+        if (icon || !(icon = calloc(1, sizeof(*icon)))) break;
+        icon->owner = nid->hWnd;
+        icon->id = nid->uID;
+        icon->number = ++next_number;
+        modify_icon(icon, nid, &pixels, width, height, &tip);
+        icon->updates = 0;
+        list_add_tail(&sni_icons, &icon->entry);
+        ret = TRUE;
+        break;
+    case NIM_MODIFY:
+        if (!icon) break;
+        modify_icon(icon, nid, &pixels, width, height, &tip);
+        ret = TRUE;
+        break;
+    case NIM_DELETE:
+        if (!icon) break;
+        icon->deleted = TRUE;
+        ret = TRUE;
+        break;
+    case NIM_SETVERSION:
+        if (!icon) break;
+        icon->version = nid->uVersion;
+        ret = TRUE;
+        break;
+    case NIM_SETFOCUS:
+        ret = icon != NULL;
+        break;
+    default:
+        FIXME("unhandled msg %u\n", msg);
+        break;
+    }
+    pthread_mutex_unlock(&sni_mutex);
+
+    free(pixels);
+    free(tip);
+    wake_systray_thread();
+    return ret;
+}
+
+/***********************************************************************
+ *           WAYLAND_CleanupIcons
+ */
+void WAYLAND_CleanupIcons(HWND hwnd)
+{
+    struct sni_icon *icon;
+
+    if (sni_state != SNI_RUNNING) return;
+
+    pthread_mutex_lock(&sni_mutex);
+    LIST_FOR_EACH_ENTRY(icon, &sni_icons, struct sni_icon, entry)
+        if (icon->owner == hwnd) icon->deleted = TRUE;
+    pthread_mutex_unlock(&sni_mutex);
+    wake_systray_thread();
+}
+
+/* everything below runs in the systray thread */
+
+static BOOL notify_owner(HWND owner, UINT callback, UINT id, UINT version, UINT msg, POINT pt)
+{
+    WPARAM wp = id;
+    LPARAM lp = msg;
+
+    if (version >= NOTIFYICON_VERSION_4)
+    {
+        wp = MAKEWPARAM(pt.x, pt.y);
+        lp = MAKELPARAM(msg, id);
+    }
+
+    TRACE("posting %#x to %p id %#x\n", msg, owner, id);
+    if (!NtUserMessageCall(owner, callback, wp, lp, 0, NtUserSendNotifyMessage, FALSE) &&
+        RtlGetLastWin32Error() == ERROR_INVALID_WINDOW_HANDLE)
+        return FALSE;
+    return TRUE;
+}
+
+/* Emulate a click of a button on the icon: down is WM_[LRM]BUTTONDOWN or
+ * WM_[LRM]BUTTONDBLCLK (the second click of a double click), followed by the
+ * button up, like explorer's own tray window does. */
+static void click_icon(struct sni_icon *icon, UINT down, int x, int y)
+{
+    HWND desktop = NtUserGetDesktopWindow();
+    DWORD pid = 0, time;
+    UINT callback, id, version, up;
+    HWND owner;
+    POINT pt;
+
+    switch (down)
+    {
+    case WM_LBUTTONDOWN: case WM_LBUTTONDBLCLK: up = WM_LBUTTONUP; break;
+    case WM_RBUTTONDOWN: case WM_RBUTTONDBLCLK: up = WM_RBUTTONUP; break;
+    default: up = WM_MBUTTONUP; break;
+    }
+
+    pthread_mutex_lock(&sni_mutex);
+    owner = icon->owner;
+    callback = icon->callback_message;
+    id = icon->id;
+    version = icon->version;
+    pthread_mutex_unlock(&sni_mutex);
+
+    if (!callback || !down) return;
+    NtUserGetCursorPos(&pt);
+
+    /* let the owner process place its menu where the tray was clicked */
+    NtUserGetWindowThread(owner, &pid);
+    if (!(time = NtGetTickCount())) time = 1;
+    NtUserSetProp(desktop, click_pid_prop, ULongToHandle(pid));
+    NtUserSetProp(desktop, click_pos_prop, ULongToHandle(MAKELONG(x, y)));
+    NtUserSetProp(desktop, click_time_prop, ULongToHandle(time));
+
+    TRACE("icon %p msg %#x at %d,%d time %u\n", icon, down, x, y, (unsigned int)time);
+
+    if (!notify_owner(owner, callback, id, version, down, pt)) goto destroyed;
+    notify_owner(owner, callback, id, version, up, pt);
+    if (version)
+    {
+        if (up == WM_LBUTTONUP) notify_owner(owner, callback, id, version, NIN_SELECT, pt);
+        if (up == WM_RBUTTONUP) notify_owner(owner, callback, id, version, WM_CONTEXTMENU, pt);
+    }
+    return;
+
+destroyed:
+    WARN("window %p was destroyed, removing icon %#x\n", owner, id);
+    pthread_mutex_lock(&sni_mutex);
+    icon->deleted = TRUE;
+    pthread_mutex_unlock(&sni_mutex);
+}
+
+/* The host only says "activated" for each click: turn a second activation
+ * within the double click time into a double click, like Windows does. */
+static UINT activate_message(struct sni_icon *icon, UINT down, UINT dblclk)
+{
+    static struct sni_icon *last_icon;
+    static UINT last_msg;
+    static DWORD last_time;
+    DWORD now = NtGetTickCount();
+    UINT msg = down;
+
+    /* GTK hosts (waybar) activate on the second press and again on its
+     * double click event, at the same time: ignore that duplicate. */
+    if (icon == last_icon && (last_msg == down || last_msg == dblclk) && now - last_time < 50)
+        return 0;
+    if (icon == last_icon && last_msg == down && now - last_time <= NtUserGetDoubleClickTime())
+        msg = dblclk;
+    last_icon = icon;
+    last_msg = msg;
+    last_time = now;
+    return msg;
+}
