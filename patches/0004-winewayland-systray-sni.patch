+/* like dbus_message_is_method_call, but also accepts calls without interface */
+static BOOL is_call(DBusMessage *msg, const char *iface, const char *member)
+{
+    const char *msg_iface = dbus_message_get_interface(msg);
+    const char *msg_member = dbus_message_get_member(msg);
+
+    if (!msg_member || strcmp(msg_member, member)) return FALSE;
+    return !msg_iface || !strcmp(msg_iface, iface);
+}
