+static DBusHandlerResult item_message(DBusConnection *conn, DBusMessage *msg, void *user_data)
+{
+    struct sni_icon *icon = user_data;
+    dbus_int32_t x = 0, y = 0;
+    DBusMessage *reply = NULL;
+    DBusMessageIter iter, array, entry;
+    const char *iface, *name;
+    unsigned int i;
+
+    if (dbus_message_get_type(msg) != DBUS_MESSAGE_TYPE_METHOD_CALL)
+        return DBUS_HANDLER_RESULT_NOT_YET_HANDLED;
+
+    TRACE("icon %p %s.%s\n", icon, debugstr_a(dbus_message_get_interface(msg)),
+          debugstr_a(dbus_message_get_member(msg)));
+
+    if (is_call(msg, ITEM_IFACE, "Activate"))
+    {
+        dbus_message_get_args(msg, NULL, DBUS_TYPE_INT32, &x, DBUS_TYPE_INT32, &y, DBUS_TYPE_INVALID);
+        click_icon(icon, activate_message(icon, WM_LBUTTONDOWN, WM_LBUTTONDBLCLK), x, y);
+        reply = dbus_message_new_method_return(msg);
+    }
+    else if (is_call(msg, ITEM_IFACE, "SecondaryActivate"))
+    {
+        /* middle click */
+        dbus_message_get_args(msg, NULL, DBUS_TYPE_INT32, &x, DBUS_TYPE_INT32, &y, DBUS_TYPE_INVALID);
+        click_icon(icon, activate_message(icon, WM_MBUTTONDOWN, WM_MBUTTONDBLCLK), x, y);
+        reply = dbus_message_new_method_return(msg);
+    }
+    else if (is_call(msg, ITEM_IFACE, "ContextMenu"))
+    {
+        dbus_message_get_args(msg, NULL, DBUS_TYPE_INT32, &x, DBUS_TYPE_INT32, &y, DBUS_TYPE_INVALID);
+        click_icon(icon, activate_message(icon, WM_RBUTTONDOWN, WM_RBUTTONDBLCLK), x, y);
+        reply = dbus_message_new_method_return(msg);
+    }
+    else if (is_call(msg, ITEM_IFACE, "Scroll") || is_call(msg, ITEM_IFACE, "ProvideXdgActivationToken"))
+    {
+        reply = dbus_message_new_method_return(msg);
+    }
+    else if (is_call(msg, PROPS_IFACE, "Get"))
+    {
+        if (!dbus_message_get_args(msg, NULL, DBUS_TYPE_STRING, &iface, DBUS_TYPE_STRING, &name,
+                                   DBUS_TYPE_INVALID))
+            reply = dbus_message_new_error(msg, DBUS_ERROR_INVALID_ARGS, NULL);
+        else if (!(reply = dbus_message_new_method_return(msg)))
+            return DBUS_HANDLER_RESULT_NEED_MEMORY;
+        else
+        {
+            BOOL found;
+
+            dbus_message_iter_init_append(reply, &iter);
+            pthread_mutex_lock(&sni_mutex);
+            found = !strcmp(iface, ITEM_IFACE) && append_property(&iter, icon, name);
+            pthread_mutex_unlock(&sni_mutex);
+            if (!found)
+            {
+                dbus_message_unref(reply);
+                reply = dbus_message_new_error(msg, DBUS_ERROR_UNKNOWN_PROPERTY, name);
+            }
+        }
+    }
+    else if (is_call(msg, PROPS_IFACE, "GetAll"))
+    {
+        if (!dbus_message_get_args(msg, NULL, DBUS_TYPE_STRING, &iface, DBUS_TYPE_INVALID))
+            reply = dbus_message_new_error(msg, DBUS_ERROR_INVALID_ARGS, NULL);
+        else if (!(reply = dbus_message_new_method_return(msg)))
+            return DBUS_HANDLER_RESULT_NEED_MEMORY;
+        else
+        {
+            dbus_message_iter_init_append(reply, &iter);
+            dbus_message_iter_open_container(&iter, DBUS_TYPE_ARRAY, "{sv}", &array);
+            if (!strcmp(iface, ITEM_IFACE))
+            {
+                pthread_mutex_lock(&sni_mutex);
+                for (i = 0; i < ARRAY_SIZE(item_properties); i++)
+                {
+                    dbus_message_iter_open_container(&array, DBUS_TYPE_DICT_ENTRY, NULL, &entry);
+                    dbus_message_iter_append_basic(&entry, DBUS_TYPE_STRING, &item_properties[i]);
+                    append_property(&entry, icon, item_properties[i]);
+                    dbus_message_iter_close_container(&array, &entry);
+                }
+                pthread_mutex_unlock(&sni_mutex);
+            }
+            dbus_message_iter_close_container(&iter, &array);
+        }
+    }
+    else if (is_call(msg, PROPS_IFACE, "Set"))
+    {
+        reply = dbus_message_new_error(msg, DBUS_ERROR_PROPERTY_READ_ONLY, NULL);
+    }
+    else if (is_call(msg, INTROSPECT_IFACE, "Introspect"))
+    {
+        const char *xml = introspect_xml;
+        if ((reply = dbus_message_new_method_return(msg)))
+            dbus_message_append_args(reply, DBUS_TYPE_STRING, &xml, DBUS_TYPE_INVALID);
+    }
+    else return DBUS_HANDLER_RESULT_NOT_YET_HANDLED;
+
+    if (!reply) return DBUS_HANDLER_RESULT_NEED_MEMORY;
+    dbus_connection_send(conn, reply, NULL);
+    dbus_message_unref(reply);
+    return DBUS_HANDLER_RESULT_HANDLED;
+}
+
+static const DBusObjectPathVTable item_vtable = { .message_function = item_message };
+
+static void register_icon(struct sni_icon *icon)
+{
+    const char *name = icon->bus_name;
+    DBusMessage *msg;
+
+    if (!watcher_present) return;
+    TRACE("registering %s\n", name);
+    if (!(msg = dbus_message_new_method_call(WATCHER_NAME, WATCHER_PATH, WATCHER_NAME,
+                                             "RegisterStatusNotifierItem")))
+        return;
+    dbus_message_append_args(msg, DBUS_TYPE_STRING, &name, DBUS_TYPE_INVALID);
+    dbus_message_set_no_reply(msg, TRUE);
+    dbus_connection_send(icon->conn, msg, NULL);
+    dbus_message_unref(msg);
+}
+
+static void emit_signal(struct sni_icon *icon, const char *signal, const char *status)
+{
+    DBusMessage *msg;
+
+    if (!(msg = dbus_message_new_signal(ITEM_PATH, ITEM_IFACE, signal))) return;
+    if (status) dbus_message_append_args(msg, DBUS_TYPE_STRING, &status, DBUS_TYPE_INVALID);
+    dbus_connection_send(icon->conn, msg, NULL);
+    dbus_message_unref(msg);
+}
+
+static void disconnect_icon(struct sni_icon *icon)
+{
+    if (!icon->conn) return;
+    dbus_connection_close(icon->conn);
+    dbus_connection_unref(icon->conn);
+    icon->conn = NULL;
+}
+
+static BOOL connect_icon(struct sni_icon *icon)
+{
+    DBusConnection *conn;
+    DBusError err;
+    int ret;
+
+    dbus_error_init(&err);
+    if (!(conn = dbus_bus_get_private(DBUS_BUS_SESSION, &err)))
+    {
+        WARN("failed to connect to the session bus: %s\n", debugstr_a(err.message));
+        dbus_error_free(&err);
+        return FALSE;
+    }
+    dbus_connection_set_exit_on_disconnect(conn, FALSE);
+    icon->conn = conn;
+
+    if (!dbus_connection_register_object_path(conn, ITEM_PATH, &item_vtable, icon))
+        goto failed;
+
+    snprintf(icon->bus_name, sizeof(icon->bus_name), "org.kde.StatusNotifierItem-%d-%u",
+             (int)getpid(), icon->number);
+    ret = dbus_bus_request_name(conn, icon->bus_name, DBUS_NAME_FLAG_DO_NOT_QUEUE, &err);
+    if (ret != DBUS_REQUEST_NAME_REPLY_PRIMARY_OWNER)
+    {
+        WARN("failed to own %s: %s\n", icon->bus_name, debugstr_a(err.message));
+        dbus_error_free(&err);
+        goto failed;
+    }
+
+    TRACE("icon %p (hwnd %p id %#x) is %s\n", icon, icon->owner, icon->id, icon->bus_name);
+    register_icon(icon);
+    return TRUE;
+
+failed:
+    disconnect_icon(icon);
+    return FALSE;
+}
+
+static DBusHandlerResult main_filter(DBusConnection *conn, DBusMessage *msg, void *user_data)
+{
+    const char *name, *old_owner, *new_owner;
+
+    if (dbus_message_is_signal(msg, DBUS_INTERFACE_DBUS, "NameOwnerChanged") &&
+        dbus_message_get_args(msg, NULL, DBUS_TYPE_STRING, &name, DBUS_TYPE_STRING, &old_owner,
+                              DBUS_TYPE_STRING, &new_owner, DBUS_TYPE_INVALID) &&
+        !strcmp(name, WATCHER_NAME))
+    {
+        TRACE("watcher owner %s -> %s\n", debugstr_a(old_owner), debugstr_a(new_owner));
+        watcher_present = new_owner[0] != 0;
+        if (watcher_present) reregister_all = TRUE;
+    }
+    return DBUS_HANDLER_RESULT_NOT_YET_HANDLED;
+}
+
+static void dispatch_connection(DBusConnection *conn)
+{
+    dbus_connection_read_write(conn, 0);
+    while (dbus_connection_dispatch(conn) == DBUS_DISPATCH_DATA_REMAINS) continue;
+}
+
+/* sync the icons with their D-Bus objects. Returns the icons that have a connection. */
+static unsigned int update_icons(struct sni_icon ***ret_icons, unsigned int *capacity)
+{
+    struct sni_icon *icon, *next, **icons = *ret_icons;
+    unsigned int count = 0, updates;
+    BOOL deleted, hidden;
+
+    pthread_mutex_lock(&sni_mutex);
+    LIST_FOR_EACH_ENTRY_SAFE(icon, next, &sni_icons, struct sni_icon, entry)
+    {
+        if (!icon->deleted && !NtUserIsWindow(icon->owner))
+        {
+            WARN("window %p was destroyed, removing icon %#x\n", icon->owner, icon->id);
+            icon->deleted = TRUE;
+        }
+        updates = icon->updates;
+        icon->updates = 0;
+        deleted = icon->deleted;
+        hidden = icon->hidden;
+        if (deleted) list_remove(&icon->entry);
+        pthread_mutex_unlock(&sni_mutex);
+
+        /* the icon can't be freed by anyone else, so it's safe to use it unlocked */
+        if (deleted)
+        {
+            TRACE("removing icon %p %s\n", icon, icon->bus_name);
+            disconnect_icon(icon);
+            free(icon->pixels);
+            free(icon->tip);
+            free(icon);
+        }
+        else
+        {
+            if (icon->conn && !dbus_connection_get_is_connected(icon->conn)) disconnect_icon(icon);
+            if (!icon->conn)
+                connect_icon(icon); /* the host fetches everything, no signals needed */
+            else
+            {
+                if (reregister_all) register_icon(icon);
+                if (updates & UPDATE_ICON) emit_signal(icon, "NewIcon", NULL);
+                if (updates & UPDATE_TIP)
+                {
+                    emit_signal(icon, "NewToolTip", NULL);
+                    emit_signal(icon, "NewTitle", NULL);
+                }
+                if (updates & UPDATE_STATUS) emit_signal(icon, "NewStatus", hidden ? "Passive" : "Active");
+            }
+            if (icon->conn)
+            {
+                if (count == *capacity)
+                {
+                    unsigned int new_capacity = max(8, *capacity * 2);
+                    struct sni_icon **tmp = realloc(icons, new_capacity * sizeof(*icons));
+                    if (!tmp) goto next;
+                    icons = *ret_icons = tmp;
+                    *capacity = new_capacity;
+                }
+                icons[count++] = icon;
+            }
+        }
+    next:
+        pthread_mutex_lock(&sni_mutex);
+    }
+    pthread_mutex_unlock(&sni_mutex);
+    reregister_all = FALSE;
+    return count;
+}
+
+/***********************************************************************
+ *           waylanddrv_unix_systray_init
+ *
+ * Called from DllMain. Succeeds if this process should run the systray thread.
+ */
+NTSTATUS waylanddrv_unix_systray_init(void *arg)
+{
+    const char *env = getenv("WINE_WAYLAND_SNI");
+
+    if (!process_name || strcmp(process_name, "explorer.exe")) return STATUS_NOT_SUPPORTED;
+    if (env && !strcmp(env, "0")) return STATUS_NOT_SUPPORTED;
+    if (pipe2(wake_pipe, O_CLOEXEC | O_NONBLOCK)) return STATUS_UNSUCCESSFUL;
+    dbus_threads_init_default();
+    sni_state = SNI_STARTING;
+    return STATUS_SUCCESS;
+}
+
+/***********************************************************************
+ *           waylanddrv_unix_systray_run
+ *
+ * The systray thread: owns all D-Bus connections.
+ */
+NTSTATUS waylanddrv_unix_systray_run(void *arg)
+{
+    struct sni_icon **icons = NULL;
+    unsigned int count, capacity = 0, i;
+    struct pollfd *fds = NULL;
+    DBusError err;
+    int fd;
+    char buf[64];
+
+    dbus_error_init(&err);
+    if ((main_conn = dbus_bus_get_private(DBUS_BUS_SESSION, &err)))
+    {
+        dbus_connection_set_exit_on_disconnect(main_conn, FALSE);
+        dbus_connection_add_filter(main_conn, main_filter, NULL, NULL);
+        dbus_bus_add_match(main_conn, "type='signal',sender='" DBUS_SERVICE_DBUS "',interface='"
+                           DBUS_INTERFACE_DBUS "',member='NameOwnerChanged',arg0='" WATCHER_NAME "'",
+                           NULL);
+        watcher_present = dbus_bus_name_has_owner(main_conn, WATCHER_NAME, NULL);
+        TRACE("connected, watcher present %d\n", watcher_present);
+    }
+    else
+    {
+        WARN("no session bus, using explorer's tray: %s\n", debugstr_a(err.message));
+        dbus_error_free(&err);
+    }
+
+    pthread_mutex_lock(&sni_mutex);
+    sni_state = main_conn ? SNI_RUNNING : SNI_DISABLED;
+    pthread_cond_broadcast(&sni_cond);
+    pthread_mutex_unlock(&sni_mutex);
+    if (!main_conn) return STATUS_UNSUCCESSFUL;
+
+    for (;;)
+    {
+        dispatch_connection(main_conn);
+        count = update_icons(&icons, &capacity);
+        for (i = 0; i < count; i++) dispatch_connection(icons[i]->conn);
+
+        free(fds);
+        if (!(fds = calloc(count + 2, sizeof(*fds)))) return STATUS_NO_MEMORY;
+        fds[0].fd = wake_pipe[0];
+        fds[0].events = POLLIN;
+        fds[1].fd = dbus_connection_get_unix_fd(main_conn, &fd) ? fd : -1;
+        fds[1].events = POLLIN | (dbus_connection_has_messages_to_send(main_conn) ? POLLOUT : 0);
+        for (i = 0; i < count; i++)
+        {
+            fds[i + 2].fd = dbus_connection_get_unix_fd(icons[i]->conn, &fd) ? fd : -1;
+            fds[i + 2].events = POLLIN | (dbus_connection_has_messages_to_send(icons[i]->conn) ? POLLOUT : 0);
+        }
+
+        /* wake up regularly to notice icons of windows that went away */
+        if (poll(fds, count + 2, 2000) < 0 && errno != EINTR) break;
+        while (read(wake_pipe[0], buf, sizeof(buf)) > 0) continue;
+    }
+
+    ERR("poll failed: %s\n", strerror(errno));
+    return STATUS_UNSUCCESSFUL;
+}
+
+#else /* SONAME_LIBDBUS_1 */
+
+LRESULT WAYLAND_NotifyIcon(HWND hwnd, UINT msg, NOTIFYICONDATAW *nid)
+{
+    return -1;
+}
+
+void WAYLAND_CleanupIcons(HWND hwnd)
+{
+}
+
+NTSTATUS waylanddrv_unix_systray_init(void *arg)
+{
+    return STATUS_NOT_SUPPORTED;
+}
+
+NTSTATUS waylanddrv_unix_systray_run(void *arg)
+{
+    return STATUS_NOT_SUPPORTED;
+}
+
+#endif /* SONAME_LIBDBUS_1 */
