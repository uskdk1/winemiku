+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+#ifdef SONAME_LIBDBUS_1
+#include <dbus/dbus.h>
+#endif
+
+#include "ntstatus.h"
+
+#include "waylanddrv.h"
+#include "ntuser.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(systray);
+
+/* Where the tray was last clicked, for placing the tray menu (see window.c).
+ * explorer sets these on the desktop window, the icon owner process reads them. */
+static const WCHAR click_pid_prop[] = {'_','_','w','i','n','e','_','t','r','a','y','_','p','i','d',0};
+static const WCHAR click_pos_prop[] = {'_','_','w','i','n','e','_','t','r','a','y','_','p','o','s',0};
+static const WCHAR click_time_prop[] = {'_','_','w','i','n','e','_','t','r','a','y','_','t','i','m','e',0};
+
+/***********************************************************************
+ *           wayland_systray_take_menu_pos
+ *
+ * Returns the tray click position (compositor coordinates) if a tray icon
+ * of this process was just clicked. Only the first caller gets it.
+ */
+BOOL wayland_systray_take_menu_pos(POINT *pos)
+{
+    static LONG last_time;
+    HWND desktop = NtUserGetDesktopWindow();
+    DWORD pid, time, packed;
+
+    pid = HandleToUlong(NtUserGetProp(desktop, click_pid_prop));
+    if (pid != GetCurrentProcessId()) return FALSE;
+    time = HandleToUlong(NtUserGetProp(desktop, click_time_prop));
+    if (!time || NtGetTickCount() - time > 2000) return FALSE;
+    if (InterlockedExchange(&last_time, time) == time) return FALSE;
+
+    packed = HandleToUlong(NtUserGetProp(desktop, click_pos_prop));
+    pos->x = (SHORT)LOWORD(packed);
+    pos->y = (SHORT)HIWORD(packed);
+    TRACE("tray menu at %s\n", wine_dbgstr_point(pos));
+    return TRUE;
+}
