+static void layer_surface_handle_configure(void *private, struct zwlr_layer_surface_v1 *layer_surface,
+                                           uint32_t serial, uint32_t width, uint32_t height)
+{
+    struct wayland_surface *surface;
+    struct wayland_win_data *data;
+    BOOL initial_configure = FALSE;
+    HWND hwnd = private;
+
+    TRACE("hwnd=%p serial=%u %ux%u\n", hwnd, serial, width, height);
+
+    if (!(data = wayland_win_data_get(hwnd))) return;
+    if ((surface = data->wayland_surface) && surface->role == WAYLAND_SURFACE_ROLE_LAYER &&
+        surface->layer_surface == layer_surface)
+    {
+        /* we choose the size ourselves, so there is nothing to process */
+        zwlr_layer_surface_v1_ack_configure(layer_surface, serial);
+        initial_configure = surface->current.serial == 0;
+        surface->current.serial = serial;
+    }
+    wayland_win_data_release(data);
+
+    if (initial_configure) NtUserExposeWindowSurface(hwnd, 0, NULL);
+}
+
+static void layer_surface_handle_closed(void *private, struct zwlr_layer_surface_v1 *layer_surface)
+{
+    TRACE("hwnd=%p\n", private);
+    NtUserPostMessage(private, WM_CANCELMODE, 0, 0);
+}
+
+static const struct zwlr_layer_surface_v1_listener layer_surface_listener =
+{
+    layer_surface_handle_configure,
+    layer_surface_handle_closed,
+};
+
+static const char *catcher_tag = "winewayland-tray-catcher";
+
+BOOL wayland_surface_is_catcher(struct wl_surface *wl_surface)
+{
+    return wl_proxy_get_tag((struct wl_proxy *)wl_surface) == &catcher_tag;
+}
+
+static void catcher_handle_configure(void *private, struct zwlr_layer_surface_v1 *layer_surface,
+                                     uint32_t serial, uint32_t width, uint32_t height)
+{
+    struct wayland_surface *surface;
+    struct wayland_win_data *data;
+    HWND hwnd = private;
+
+    TRACE("hwnd=%p serial=%u %ux%u\n", hwnd, serial, width, height);
+
+    if (!(data = wayland_win_data_get(hwnd))) return;
+    if ((surface = data->wayland_surface) && surface->role == WAYLAND_SURFACE_ROLE_LAYER &&
+        surface->catcher_layer == layer_surface)
+    {
+        zwlr_layer_surface_v1_ack_configure(layer_surface, serial);
+        if (width && height)
+        {
+            wp_viewport_set_destination(surface->catcher_viewport, width, height);
+            wl_surface_attach(surface->catcher_surface, surface->catcher_buffer->wl_buffer, 0, 0);
+            wl_surface_damage_buffer(surface->catcher_surface, 0, 0, 1, 1);
+        }
+        wl_surface_commit(surface->catcher_surface);
+        wl_display_flush(process_wayland.wl_display);
+    }
+    wayland_win_data_release(data);
+}
+
+static const struct zwlr_layer_surface_v1_listener catcher_listener =
+{
+    catcher_handle_configure,
+    layer_surface_handle_closed,
+};
+
+static void destroy_catcher(struct wayland_surface *surface)
+{
+    struct wayland_pointer *pointer = &process_wayland.pointer;
+
+    pthread_mutex_lock(&pointer->mutex);
+    if (pointer->focused_catcher && pointer->focused_hwnd == surface->hwnd)
+    {
+        pointer->focused_hwnd = NULL;
+        pointer->focused_catcher = FALSE;
+        pointer->enter_serial = 0;
+    }
+    pthread_mutex_unlock(&pointer->mutex);
+
+    if (surface->catcher_layer) zwlr_layer_surface_v1_destroy(surface->catcher_layer);
+    if (surface->catcher_viewport) wp_viewport_destroy(surface->catcher_viewport);
+    if (surface->catcher_surface) wl_surface_destroy(surface->catcher_surface);
+    if (surface->catcher_buffer) wayland_shm_buffer_unref(surface->catcher_buffer);
+    surface->catcher_layer = NULL;
+    surface->catcher_viewport = NULL;
+    surface->catcher_surface = NULL;
+    surface->catcher_buffer = NULL;
+}
+
+/* Clicks outside of a tray menu never reach us on Wayland, so cover the
+ * output (except the bars) with a transparent surface below the menu. Its
+ * clicks are sent to the menu as clicks outside of it, which closes it. */
+static void create_catcher(struct wayland_surface *surface, struct wl_output *wl_output)
+{
+    if (!process_wayland.wp_viewporter) return;
+
+    if (!(surface->catcher_buffer = wayland_shm_buffer_create(1, 1, WL_SHM_FORMAT_ARGB8888)) ||
+        !(surface->catcher_surface = wl_compositor_create_surface(process_wayland.wl_compositor)))
+        goto failed;
+    wl_surface_set_user_data(surface->catcher_surface, surface->hwnd);
+    wl_proxy_set_tag((struct wl_proxy *)surface->catcher_surface, &catcher_tag);
+    memset(surface->catcher_buffer->map_data, 0, surface->catcher_buffer->map_size);
+
+    if (!(surface->catcher_viewport = wp_viewporter_get_viewport(process_wayland.wp_viewporter,
+                                                                 surface->catcher_surface)))
+        goto failed;
+    /* the top layer is below the menu (overlay) but above the windows */
+    if (!(surface->catcher_layer =
+          zwlr_layer_shell_v1_get_layer_surface(process_wayland.zwlr_layer_shell_v1,
+                                                surface->catcher_surface, wl_output,
+                                                ZWLR_LAYER_SHELL_V1_LAYER_TOP,
+                                                "wine-tray-menu-catcher")))
+        goto failed;
+    zwlr_layer_surface_v1_add_listener(surface->catcher_layer, &catcher_listener, surface->hwnd);
+    zwlr_layer_surface_v1_set_anchor(surface->catcher_layer,
+                                     ZWLR_LAYER_SURFACE_V1_ANCHOR_TOP | ZWLR_LAYER_SURFACE_V1_ANCHOR_BOTTOM |
+                                     ZWLR_LAYER_SURFACE_V1_ANCHOR_LEFT | ZWLR_LAYER_SURFACE_V1_ANCHOR_RIGHT);
+    zwlr_layer_surface_v1_set_size(surface->catcher_layer, 0, 0);
+    zwlr_layer_surface_v1_set_exclusive_zone(surface->catcher_layer, 0);
+    wl_surface_commit(surface->catcher_surface);
+    return;
+
+failed:
+    ERR("failed to create the tray menu click catcher\n");
+    destroy_catcher(surface);
+}
