+static void append_variant_string(DBusMessageIter *iter, const char *str)
+{
+    DBusMessageIter var;
+
+    dbus_message_iter_open_container(iter, DBUS_TYPE_VARIANT, "s", &var);
+    dbus_message_iter_append_basic(&var, DBUS_TYPE_STRING, &str);
+    dbus_message_iter_close_container(iter, &var);
+}
+
+/* appends an a(iiay) */
+static void append_pixmaps(DBusMessageIter *iter, const struct sni_icon *icon)
+{
+    DBusMessageIter array, st, bytes;
+
+    dbus_message_iter_open_container(iter, DBUS_TYPE_ARRAY, "(iiay)", &array);
+    if (icon && icon->pixels)
+    {
+        const unsigned char *data = icon->pixels;
+        dbus_int32_t width = icon->width, height = icon->height;
+
+        dbus_message_iter_open_container(&array, DBUS_TYPE_STRUCT, NULL, &st);
+        dbus_message_iter_append_basic(&st, DBUS_TYPE_INT32, &width);
+        dbus_message_iter_append_basic(&st, DBUS_TYPE_INT32, &height);
+        dbus_message_iter_open_container(&st, DBUS_TYPE_ARRAY, "y", &bytes);
+        dbus_message_iter_append_fixed_array(&bytes, DBUS_TYPE_BYTE, &data, width * height * 4);
+        dbus_message_iter_close_container(&st, &bytes);
+        dbus_message_iter_close_container(&array, &st);
+    }
+    dbus_message_iter_close_container(iter, &array);
+}
