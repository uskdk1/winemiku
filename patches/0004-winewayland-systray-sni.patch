+/**********************************************************************
+ *          wayland_surface_reconfigure_layer
+ *
+ * Sizes and places the layer surface. Returns whether it can show contents.
+ */
+static BOOL wayland_surface_reconfigure_layer(struct wayland_surface *surface, RECT rect)
+{
+    int width = rect.right - rect.left, height = rect.bottom - rect.top;
+    int output_w = surface->layer_output.right - surface->layer_output.left;
+    int output_h = surface->layer_output.bottom - surface->layer_output.top;
+    uint32_t anchor = ZWLR_LAYER_SURFACE_V1_ANCHOR_LEFT;
+    int left;
+
+    if (width <= 0 || height <= 0) return FALSE;
+
+    if (width != surface->layer_width || height != surface->layer_height ||
+        !surface->layer_committed)
+    {
+        /* open at the click, but keep the menu inside the output */
+        left = surface->layer_pos.x;
+        if (output_w > 0 && left + width > output_w) left = output_w - width;
+        if (left < 0) left = 0;
+        /* a bar at the bottom: open upwards */
+        if (output_h > 0 && surface->layer_pos.y > output_h / 2)
+            anchor |= ZWLR_LAYER_SURFACE_V1_ANCHOR_BOTTOM;
+        else
+            anchor |= ZWLR_LAYER_SURFACE_V1_ANCHOR_TOP;
+
+        TRACE("hwnd=%p size=%dx%d left=%d anchor=%#x\n", surface->hwnd, width, height, left, anchor);
+
+        zwlr_layer_surface_v1_set_size(surface->layer_surface, width, height);
+        zwlr_layer_surface_v1_set_anchor(surface->layer_surface, anchor);
+        zwlr_layer_surface_v1_set_margin(surface->layer_surface, 0, 0, 0, left);
+        surface->layer_width = width;
+        surface->layer_height = height;
+
+        if (!surface->layer_committed)
+        {
+            wl_surface_commit(surface->wl_surface);
+            wl_display_flush(process_wayland.wl_display);
+            surface->layer_committed = TRUE;
+        }
+    }
+
+    return surface->current.serial != 0;
+}
+
 /**********************************************************************
  *          wayland_surface_reconfigure
  *
@@ -905,6 +1173,10 @@ BOOL wayland_surface_reconfigure(struct wayland_surface *surface)
         if (!surface->wl_subsurface) break; /* surface role has been cleared */
         wayland_surface_reconfigure_subsurface(surface);
         break;
+    case WAYLAND_SURFACE_ROLE_LAYER:
+        if (!surface->layer_surface) break; /* surface role has been cleared */
+        if (!wayland_surface_reconfigure_layer(surface, rect)) return FALSE;
+        break;
     }
 
     wayland_surface_reconfigure_size(surface, rect.right - rect.left, rect.bottom - rect.top);
