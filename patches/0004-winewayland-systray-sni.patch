+/**********************************************************************
+ *          wayland_surface_make_layer
+ *
+ * Gives the layer surface role to a plain wayland surface, placed at the
+ * given compositor (logical, global) position. Used for tray menus, which
+ * must appear next to the bar on Wayland where clients can't position
+ * their toplevels.
+ */
+void wayland_surface_make_layer(struct wayland_surface *surface, POINT pos)
+{
+    struct wayland_output *output;
+    struct wl_output *wl_output = NULL;
+    RECT output_rect = {0};
+
+    assert(!surface->role || surface->role == WAYLAND_SURFACE_ROLE_LAYER);
+    if (surface->layer_surface) return;
+
+    wayland_surface_clear_role(surface);
+    surface->role = WAYLAND_SURFACE_ROLE_LAYER;
+
+    pthread_mutex_lock(&process_wayland.output_mutex);
+    wl_list_for_each(output, &process_wayland.output_list, link)
+    {
+        RECT rect;
+        BOOL inside;
+
+        SetRect(&rect, output->current.logical_x, output->current.logical_y,
+                output->current.logical_x + output->current.logical_w,
+                output->current.logical_y + output->current.logical_h);
+        inside = pos.x >= rect.left && pos.x < rect.right && pos.y >= rect.top && pos.y < rect.bottom;
+        /* the output that was clicked, or else the first one */
+        if (!wl_output || inside)
+        {
+            wl_output = output->wl_output;
+            output_rect = rect;
+        }
+        if (inside) break;
+    }
+    pthread_mutex_unlock(&process_wayland.output_mutex);
+
+    TRACE("surface=%p pos=%s output=%s\n", surface, wine_dbgstr_point(&pos),
+          wine_dbgstr_rect(&output_rect));
+
+    surface->layer_surface =
+        zwlr_layer_shell_v1_get_layer_surface(process_wayland.zwlr_layer_shell_v1,
+                                              surface->wl_surface, wl_output,
+                                              ZWLR_LAYER_SHELL_V1_LAYER_OVERLAY,
+                                              "wine-tray-menu");
+    if (!surface->layer_surface)
+    {
+        wayland_surface_clear_role(surface);
+        ERR("Failed to assign layer surface role to wayland surface\n");
+        return;
+    }
+    zwlr_layer_surface_v1_add_listener(surface->layer_surface, &layer_surface_listener,
+                                       surface->hwnd);
+    if (zwlr_layer_surface_v1_get_version(surface->layer_surface) >=
+        ZWLR_LAYER_SURFACE_V1_KEYBOARD_INTERACTIVITY_ON_DEMAND_SINCE_VERSION)
+        zwlr_layer_surface_v1_set_keyboard_interactivity(
+            surface->layer_surface, ZWLR_LAYER_SURFACE_V1_KEYBOARD_INTERACTIVITY_ON_DEMAND);
+    /* avoid the bar's exclusive zone, i.e. open just below/above it */
+    zwlr_layer_surface_v1_set_exclusive_zone(surface->layer_surface, 0);
+
+    create_catcher(surface, wl_output);
+
+    surface->layer_pos.x = pos.x - output_rect.left;
+    surface->layer_pos.y = pos.y - output_rect.top;
+    surface->layer_output = output_rect;
+    surface->layer_width = surface->layer_height = 0;
+    surface->layer_committed = FALSE;
+
+    wayland_surface_init_fractional_scale(surface, 1.0);
+    /* the initial commit needs a size, done in wayland_surface_reconfigure_layer */
+}
+
