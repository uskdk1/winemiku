+/* A click on the tray menu click catcher: move the cursor far away from the
+ * menu (and its submenus), so that the click is outside of it. */
+static void move_cursor_out_of_menu(HWND hwnd)
+{
+    RECT screen = NtUserGetVirtualScreenRect(MDT_DEFAULT), rect;
+    struct wayland_win_data *data;
+    INPUT input = {0};
+
+    if (!(data = wayland_win_data_get(hwnd))) return;
+    rect = data->wayland_surface ? data->wayland_surface->window.rect : data->rects.window;
+    wayland_win_data_release(data);
+
+    input.type = INPUT_MOUSE;
+    input.mi.dx = (rect.left + rect.right) / 2 < (screen.left + screen.right) / 2 ?
+                  screen.right - 1 : screen.left;
+    input.mi.dy = (rect.top + rect.bottom) / 2 < (screen.top + screen.bottom) / 2 ?
+                  screen.bottom - 1 : screen.top;
+    input.mi.dwFlags = MOUSEEVENTF_MOVE | MOUSEEVENTF_ABSOLUTE;
+    TRACE("hwnd=%p menu=%s click at %d,%d\n", hwnd, wine_dbgstr_rect(&rect),
+          (int)input.mi.dx, (int)input.mi.dy);
+    NtUserSendHardwareInput(hwnd, SEND_HWMSG_RAWINPUT, &input, 0);
+}
