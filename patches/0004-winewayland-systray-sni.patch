+enum
+{
+    UPDATE_ICON   = 0x1,
+    UPDATE_TIP    = 0x2,
+    UPDATE_STATUS = 0x4,
+};
+
+struct sni_icon
+{
+    struct list entry;
+    /* protected by sni_mutex */
+    HWND owner;
+    UINT id;
+    UINT callback_message;
+    UINT version;
+    BOOL hidden;
+    BOOL deleted;          /* freed by the systray thread */
+    unsigned int updates;  /* UPDATE_* signals to emit */
+    char *tip;             /* UTF-8 */
+    unsigned char *pixels; /* ARGB32, network byte order (SNI IconPixmap) */
+    int width, height;
+    /* only used by the systray thread */
+    unsigned int number;
+    DBusConnection *conn;
+    char bus_name[64];
+};
