+    case IMAGE_FILE_MACHINE_AMD64: arch = L"x86_64-windows"; break;
+    case IMAGE_FILE_MACHINE_ARM64: arch = L"aarch64-windows"; break;
+    case IMAGE_FILE_MACHINE_ARMNT: arch = L"arm-windows"; break;
