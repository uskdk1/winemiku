+static BOOL builtin_files_equal(HANDLE a, HANDLE b)
+{
+    static const DWORD chunk = 0x10000;
+    LARGE_INTEGER size_a, size_b;
+    DWORD read_a, read_b;
+    BYTE *buf;
+    BOOL ret = FALSE;
+
+    if (!GetFileSizeEx(a, &size_a) || !GetFileSizeEx(b, &size_b) ||
+        size_a.QuadPart != size_b.QuadPart)
+        return FALSE;
+    if (!(buf = malloc(2 * chunk))) return FALSE;
+    SetFilePointer(a, 0, NULL, FILE_BEGIN);
+    SetFilePointer(b, 0, NULL, FILE_BEGIN);
+    for (;;)
+    {
+        if (!ReadFile(a, buf, chunk, &read_a, NULL) ||
+            !ReadFile(b, buf + chunk, chunk, &read_b, NULL) ||
+            read_a != read_b || memcmp(buf, buf + chunk, read_a))
+            break;
+        if (!read_a)
+        {
+            ret = TRUE;
+            break;
+        }
+    }
+    free(buf);
+    return ret;
+}
+
+static BOOL builtin_compare_with(HANDLE file, const WCHAR *dir, const WCHAR *arch, const WCHAR *name)
+{
+    WCHAR *path;
+    HANDLE ref;
+    BOOL ret = FALSE;
+
+    if (!(path = malloc((wcslen(dir) + wcslen(arch) + wcslen(name) + 3) * sizeof(WCHAR))))
+        return FALSE;
+    if (arch[0]) swprintf(path, wcslen(dir) + wcslen(arch) + wcslen(name) + 3, L"%s\\%s\\%s", dir, arch, name);
+    else swprintf(path, wcslen(dir) + wcslen(name) + 2, L"%s\\%s", dir, name);
+    ref = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_DELETE, NULL, OPEN_EXISTING, 0, NULL);
+    if (ref != INVALID_HANDLE_VALUE)
+    {
+        ret = builtin_files_equal(file, ref);
+        CloseHandle(ref);
+    }
+    TRACE("%s: %d\n", debugstr_w(path), ret);
+    free(path);
+    return ret;
+}
+
+/* Returns TRUE if the file is an unmodified copy of a Wine builtin module,
+ * i.e. it carries the "Wine builtin DLL" marker and is byte-for-byte identical
+ * to the module of the same name in one of Wine's dll directories, or of a
+ * native DLL from one of the WINEMIKU_SIGNED_DLL_DIRS directories. */
+BOOL WINTRUST_IsWineBuiltinFile(HANDLE hfile, const WCHAR *path)
+{
+    static const char builtin_signature[] = "Wine builtin DLL";
+    IMAGE_DOS_HEADER dos;
+    struct
+    {
+        DWORD Signature;
+        IMAGE_FILE_HEADER FileHeader;
+    } nt;
+    char marker[sizeof(builtin_signature)];
+    WCHAR *full = NULL, *dir = NULL, var[32];
+    const WCHAR *name, *arch;
+    HANDLE file;
+    DWORD len, read;
+    unsigned int i;
+    BOOL ret = FALSE;
+
+    if (!path || !path[0])
+    {
+        if (!hfile || hfile == INVALID_HANDLE_VALUE) return FALSE;
+        if (!(len = GetFinalPathNameByHandleW(hfile, NULL, 0, 0))) return FALSE;
+        if (!(full = malloc(len * sizeof(WCHAR)))) return FALSE;
+        if (!GetFinalPathNameByHandleW(hfile, full, len, 0)) goto done;
+        path = full;
+    }
+    file = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                       NULL, OPEN_EXISTING, 0, NULL);
+    if (file == INVALID_HANDLE_VALUE) goto done;
+
+    name = wcsrchr(path, '\\');
+    name = name ? name + 1 : path;
+
+    if (!ReadFile(file, &dos, sizeof(dos), &read, NULL) || read != sizeof(dos) ||
+        dos.e_magic != IMAGE_DOS_SIGNATURE ||
+        !ReadFile(file, marker, sizeof(marker), &read, NULL) || read != sizeof(marker))
+        goto close;
+
+    if (memcmp(marker, builtin_signature, sizeof(marker)))
+    {
+        /* Not a Wine builtin: native DLLs installed into the prefix by the
+         * launcher (e.g. DXVK) are listed as unix directories in
+         * WINEMIKU_SIGNED_DLL_DIRS, separated by ':'. */
+        WCHAR *p, *next;
+
+        if (!(len = GetEnvironmentVariableW(L"WINEMIKU_SIGNED_DLL_DIRS", NULL, 0))) goto close;
+        if (!(dir = malloc((len + 8) * sizeof(WCHAR)))) goto close;
+        if (!GetEnvironmentVariableW(L"WINEMIKU_SIGNED_DLL_DIRS", dir, len)) goto close;
+        for (p = dir; p && *p && !ret; p = next)
+        {
+            WCHAR *nt_dir, *q;
+
+            if ((next = wcschr(p, ':'))) *next++ = 0;
+            if (*p != '/') continue;
+            if (!(nt_dir = malloc((wcslen(p) + 9) * sizeof(WCHAR)))) break;
+            swprintf(nt_dir, wcslen(p) + 9, L"\\??\\unix%s", p);
+            for (q = nt_dir; *q; q++) if (*q == '/') *q = '\\';
