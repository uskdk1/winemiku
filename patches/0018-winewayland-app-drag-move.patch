+/***********************************************************************
+ *           wayland_pointer_release_left_button
+ *
+ * Release the left button for Win32 after handing its press to an interactive
+ * move: the compositor's grab keeps the real release from us.
+ */
+void wayland_pointer_release_left_button(HWND hwnd, uint32_t button_serial)
+{
+    struct wayland_pointer *pointer = &process_wayland.pointer;
+    INPUT input = {.type = INPUT_MOUSE, .mi.dwFlags = MOUSEEVENTF_LEFTUP};
+
+    pthread_mutex_lock(&pointer->mutex);
+    if (pointer->button_serial == button_serial) pointer->button_serial = 0;
+    pthread_mutex_unlock(&pointer->mutex);
+
+    NtUserSendHardwareInput(hwnd, SEND_HWMSG_RAWINPUT, &input, 0);
+    wl_display_flush(process_wayland.wl_display);
+}
