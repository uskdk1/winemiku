+/* command written to Exec= lines; WINEMENUBUILDER_LAUNCHER overrides the default "wine"
+ * (for setups where wine isn't in PATH or needs a wrapper) */
+static const char *wine_launcher(void)
+{
+    static char *cmd;
+    const WCHAR *launcher;
+
+    if (cmd) return cmd;
+    if ((launcher = _wgetenv( L"WINEMENUBUILDER_LAUNCHER" )) && *launcher)
+    {
+        char *path = wchars_to_utf8_chars( launcher );
+        cmd = xmalloc( strlen( path ) + 3 );
+        sprintf( cmd, "\"%s\"", path );
+        heap_free( path );
+    }
+    else
+    {
+        cmd = xmalloc( 5 );
+        strcpy( cmd, "wine" );
+    }
+    return cmd;
+}
