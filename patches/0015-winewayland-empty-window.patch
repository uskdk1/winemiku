diff --git a/dlls/winewayland.drv/window.c b/dlls/winewayland.drv/window.c
index dc7bbec..b910809 100644
--- a/dlls/winewayland.drv/window.c
+++ b/dlls/winewayland.drv/window.c
@@ -199,7 +199,9 @@ static BOOL wayland_win_data_create_wayland_surface(struct wayland_win_data *dat
     visible = ((NtUserGetWindowLongW(data->hwnd, GWL_STYLE) & WS_VISIBLE) == WS_VISIBLE) &&
                (!(exstyle & WS_EX_LAYERED) || data->layered_attribs_set);
 
-    if (!visible) role = WAYLAND_SURFACE_ROLE_NONE;
+    /* an empty window has nothing to show, and as a toplevel the compositor
+     * would give it a size (Delphi's 0x0 TApplication window) */
+    if (!visible || IsRectEmpty(&data->rects.window)) role = WAYLAND_SURFACE_ROLE_NONE;
     /* the first popup shown right after a tray icon click (the tray menu) is
      * placed where the tray was clicked, as a layer surface */
     else if (data->wayland_surface && data->wayland_surface->role == WAYLAND_SURFACE_ROLE_LAYER &&
@@ -501,6 +503,9 @@ void WAYLAND_WindowPosChanged(HWND hwnd, HWND insert_after, HWND owner_hint, UIN
     if (!managed && surface) owner = owner_hint;
     owner_data = owner && owner != hwnd ? wayland_win_data_get(owner) : NULL;
     owner_surface = owner_data ? owner_data->wayland_surface : NULL;
+    /* an owner that isn't on screen (no role, e.g. the empty TApplication window
+     * owning Delphi's forms) can't carry a subsurface: show it as a toplevel */
+    if (owner_surface && !owner_surface->role) owner_surface = NULL;
 
     data->rects = *new_rects;
     data->is_fullscreen = fullscreen;
