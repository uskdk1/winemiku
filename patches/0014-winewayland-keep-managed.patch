diff --git a/dlls/winewayland.drv/window.c b/dlls/winewayland.drv/window.c
index 4447e73..dc7bbec 100644
--- a/dlls/winewayland.drv/window.c
+++ b/dlls/winewayland.drv/window.c
@@ -489,9 +489,16 @@ void WAYLAND_WindowPosChanged(HWND hwnd, HWND insert_after, HWND owner_hint, UIN
     /* Get the managed state with win_data unlocked, as is_window_managed
      * may need to query win_data information about other HWNDs and thus
      * acquire the lock itself internally. */
-    if (!(managed = is_window_managed(hwnd, swp_flags, fullscreen)) && surface) owner = owner_hint;
+    managed = is_window_managed(hwnd, swp_flags, fullscreen);
 
     if (!(data = wayland_win_data_get(hwnd))) return;
+    /* Like winex11, a shown window stays managed until it's hidden (the
+     * server already cleared WS_VISIBLE for SWP_HIDEWINDOW): a captionless
+     * popup is only managed while active, and losing activation (e.g. a
+     * click on its owner) would turn its xdg_toplevel into a subsurface and
+     * back on the next activation, which the compositor places anew each time. */
+    if (!managed && (NtUserGetWindowLongW(hwnd, GWL_STYLE) & WS_VISIBLE)) managed = data->managed;
+    if (!managed && surface) owner = owner_hint;
     owner_data = owner && owner != hwnd ? wayland_win_data_get(owner) : NULL;
     owner_surface = owner_data ? owner_data->wayland_surface : NULL;
 
