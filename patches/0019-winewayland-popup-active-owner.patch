+    /* An unmanaged popup belongs on screen to the window it's shown over, which
+     * isn't always its owner: FL Studio's dropdown lists in the Settings window
+     * are owned by the main window, and would show over it, or below Settings.
+     * Prefer the active window when the popup is over it (toplevel positions
+     * are made up on Wayland, so other windows' rects can't be trusted as much).
+     * Without an owner on screen it would become a toplevel, which the
+     * compositor places anywhere and gives the keyboard focus to: attach it to
+     * the window it is shown over or next to instead. */
+    popup_owner = 0;
+    if (!managed && surface &&
+        (NtUserGetWindowLongW(hwnd, GWL_STYLE) & (WS_POPUP | WS_VISIBLE)) == (WS_POPUP | WS_VISIBLE))
+    {
+        HWND active = get_active_window();
+
+        if (active && active != hwnd && active != owner &&
+            is_popup_near_toplevel(active, &new_rects->window))
+            popup_owner = active;
+        else if (!owner_surface)
+            popup_owner = find_popup_owner(hwnd, &new_rects->window);
+    }
+    if (popup_owner)
     {
